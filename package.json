{
  "name": "transitlog-hfp-csv-sink-monitor",
  "version": "1.0.0",
  "main": "monitor.js",
  "license": "ISC",
  "scripts": {
    "start": "ts-node-dev -r dotenv/config src/index.ts",
    "build": "tsc -p .",
    "start:production": "node -r dotenv/config build/index.js",
    "test": "TZ=Europe/Helsinki JEST_JUNIT_CLASSNAME=\"{filepath}\" jest --coverage --reporters=jest-junit --reporters=default",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "ts:check": "tsc --noEmit -p tsconfig.test.json",
    "check-and-build": "npm run ts:check && npm run prettier:check && npm run test && npm run build"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "12.8.0",
    "date-fns": "2.28.0",
    "dotenv": "14.2.0",
    "esm": "3.2.25",
    "fs-extra": "9.1.0",
    "got": "11.5.1",
    "lodash": "^4.17.21",
    "node-fetch": "2.6.1",
    "node-schedule": "2.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/node-fetch": "^2.6.1",
    "@types/node-schedule": "^1.3.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^1.1.8",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
